# Copy to .env and fill in the two secrets. .env is git-ignored.
TELEGRAM_BOT_TOKEN=
# Leave TELEGRAM_ALLOWED_USER_ID empty: the first private message pairs the bot with its sender.
TELEGRAM_ALLOWED_USER_ID=
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
MONTHLY_CEILING_USD=5
SESSION_TIME=07:00
REVIEW_TIME=20:00
BODY_PROMPT_TIME=07:00
TIMEZONE=Asia/Hong_Kong
MODEL_FAST=claude-haiku-5-5
MODEL_COACH=claude-opus-5-5
DATA_DIR=data
